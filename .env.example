# Copia este archivo a .env y ajusta según tu ambiente. Nunca commitees .env real.
# Ver sección 17 del documento de arquitectura para la lista completa de variables.

APP_ENV=local
LOG_LEVEL=INFO

# Base de datos local (Docker Compose). En cloud, DATABASE_URL se resuelve desde
# Secrets Manager por el runner de despliegue, nunca se pone en texto plano aquí.
DATABASE_URL=postgresql+psycopg://aula:aula@localhost:5432/aula

AWS_REGION=us-east-1
SCHOOL_TIMEZONE=America/El_Salvador
API_SCOPE=school-api/access

# Cognito (fase cloud; dejar vacío en local)
COGNITO_ISSUER=
COGNITO_CLIENT_ID=

# Auth local (solo APP_ENV=local; la app se niega a arrancar si esto es true fuera de local)
LOCAL_AUTH_ENABLED=true
LOCAL_JWT_SECRET=local-only-dev-secret-do-not-use-in-cloud
LOCAL_JWT_ISSUER=aula-local-dev

FILES_BUCKET=aula-files-local
QUEUE_URLS=
ALLOWED_ORIGINS=["http://localhost:5173"]
