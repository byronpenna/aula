NEXT_PUBLIC_AULA_URL=https://main.dy880wnmeoiy1.amplifyapp.com

# Área admin (/admin): API de aula virtual (apps/api), módulo public_site.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Login local (sección 17, igual patrón que apps/web/.env): deja NEXT_PUBLIC_AUTH_MODE
# sin definir o distinto de "cognito" para desarrollo local contra /auth/local/token
# (requiere APP_ENV=local en apps/api). Para probar el flujo real de Cognito,
# descomenta y ajusta contra el entorno cloud (infra: identity-stack.ts
# PublicWebAdminClient/UserPoolId/HostedUiDomainUrl); agrega antes
# http://localhost:3000/admin/callback a publicWebCallbackUrls en infra/bin/aula.ts.
# NEXT_PUBLIC_AUTH_MODE=cognito
# NEXT_PUBLIC_COGNITO_AUTHORITY=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
# NEXT_PUBLIC_COGNITO_CLIENT_ID=<public-web-admin-client-id>
# NEXT_PUBLIC_COGNITO_DOMAIN=https://<hosted-ui-domain>
