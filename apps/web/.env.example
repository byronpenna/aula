VITE_API_BASE_URL=http://localhost:8000/api/v1

# Login local (sección 17): deja VITE_AUTH_MODE sin definir o distinto de
# "cognito" para desarrollo local contra /auth/local/token. Para probar el flujo
# de Cognito en local, descomenta y ajusta los valores del entorno cloud
# (infra: identity-stack.ts UserPoolId/UserPoolClientId/HostedUiDomainUrl); nota
# que el User Pool solo acepta los callbackUrls/logoutUrls configurados en
# infra/bin/aula.ts, así que agrega http://localhost:5173/callback ahí también
# antes de que funcione.
# VITE_AUTH_MODE=cognito
# VITE_COGNITO_AUTHORITY=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
# VITE_COGNITO_CLIENT_ID=<user-pool-client-id>
# VITE_COGNITO_DOMAIN=https://<hosted-ui-domain>
